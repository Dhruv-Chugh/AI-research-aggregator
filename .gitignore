# ==============================================================================
# Axiom Dispatch - Git Ignore Configuration
# Ensures sensitive keys, virtualenvs, local caches, and exports are never committed
# ==============================================================================

# Python bytecode & build artifacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/

# Environment files & Secrets (STRICTLY PRIVATE)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Local databases & logs
*.db
*.sqlite3
*.log
logs/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Editor & IDE settings
.vscode/
.idea/
*.swp
*.swo

# Generated briefing exports, PDFs, and HTML previews
exports/
