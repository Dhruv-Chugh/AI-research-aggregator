# ==============================================================================
# Axiom Dispatch — Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news_db

# ------------------------------------------------------------------------------
# 2. Runtime Environment & Pipeline Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_LOOKBACK_HOURS=24
ENABLE_READER_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. Automated Intelligence Briefing Delivery
# ------------------------------------------------------------------------------
RECIPIENT_EMAIL=subscriber@example.com
SUBSCRIBER_NAME=AI Research Subscriber

# Primary Local Delivery (Gmail SMTP TLS with automatic 587 -> 465 port failover)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_dispatch_bot@gmail.com
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=abcd efgh ijkl mnop

# HTTPS Email Fallback on main / Primary Email Transport on deployment-part-2
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=The AI Dispatch <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 4. LLM Intelligence Providers (Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite

# OpenAI API Key (Optional fallback: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. Optional Cloud YouTube Transcript Proxy (Recommended on Cloud Hosts)
# ------------------------------------------------------------------------------
# YOUTUBE_PROXY=http://user:pass@proxy-host:port
